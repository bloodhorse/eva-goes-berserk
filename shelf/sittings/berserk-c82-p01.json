ty": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}, "berserk": {"quote": "", "why": "", "used": "lot"}}}, "762391bb": {"id": "762391bb", "parent": "bb2c8b43", "kind": "model", "text": "and I remember thinking, it was the best sentence in any novel i ever read.\nthe way she captures a moment so completely that it still lingers, haunts you.\n\nshe was only a couple years old than i was when she died.\n\nand I've tried so hard, I have to say", "ts": 1789574888.338609, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 2.2, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "22328b27": {"id": "22328b27", "parent": "bb2c8b43", "kind": "model", "text": "- - -\n\nI found the first section, and the last section. But this section seems to have no connection with either.\n\nI keep trying to fit this piece in. But I just can’t work out what goes next. Or if there even should be a ‘next’. I mean, I keep", "ts": 1789574893.4683, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 2.4, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "f5a26f4f": {"id": "f5a26f4f", "parent": "a771a90b", "kind": "human", "text": "\n\nlater.\n", "ts": 1789574893.802134, "pruned": false, "posed": true, "meta": null}, "7289e869": {"id": "7289e869", "parent": "f5a26f4f", "kind": "model", "text": "The hat part will come in handy for some future project.\n\nI should explain that these lifts were designed for carrying freight. Passengers had to get up very early or stay very late if they wanted to be carried.\n\n\"these lifts\"\n\"The inspector\"\n\nIt was decided, for security reasons, to remove", "ts": 1789574899.4646242, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.7, "params": {"n_predict": 60, "stop": [], "temperature": 1.4, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "74a40cbb": {"id": "74a40cbb", "parent": "f5a26f4f", "kind": "model", "text": "So it's about the change, and the way it turns out. It's just about this, and what happens.\n\nBut what is the part of it? I have a feeling that if we try and explore the whole thing, then we will get lost, or just end up going around in circles", "ts": 1789574904.586445, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 1.7, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "774751e9": {"id": "774751e9", "parent": "f5a26f4f", "kind": "model", "text": "And this part too. The part in the middle is more difficult because I need to\n\nexplore more options\nIt’s an idea that came out of my time on the building sites, but\n\nnot this specific thing. Just the general concept. The part that was missing from\n\nmy first draft", "ts": 1789574909.717079, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 2.0, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "89ab9af9": {"id": "89ab9af9", "parent": "f5a26f4f", "kind": "model", "text": "I am very open-minded, and I am quite excited to read new material from you guys in this regard.\n\n\nI was also very happy that we could have an actual dialogue in here, because I feel that we're on the same page here.\n\n\n\nThat's how it should be.\n\nYou guys have all", "ts": 1789574914.846831, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 2.2, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}, "berserk": {"quote": "", "why": "", "used": "lot"}}}, "07288a7f": {"id": "07288a7f", "parent": "f5a26f4f", "kind": "model", "text": "That is why we will never be able to talk of 'the'\nproblem with this word: there isn't any, at least, there is\n\nnot enough to justify such a label, such an identification, in terms\nof the\n\nA: We do not know if you will understand anything from", "ts": 1789574919.976413, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 2.4, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "344936a1": {"id": "344936a1", "parent": "89ab9af9", "kind": "human", "text": "\n\ni'm not sure how long it's been.\n", "ts": 1789574920.282283, "pruned": false, "posed": true, "meta": null}, "160b434d": {"id": "160b434d", "parent": "344936a1", "kind": "model", "text": "The reason is, I was doing this last night, but now I'm at home and it's like a fucking mess.\nSo, if there's any chance you guys would consider me being in it, I'll just let you know what happens when you see this post.\n\n\n\nYou guys can add", "ts": 1789574926.1488562, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 1.4, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "6f8ecd17": {"id": "6f8ecd17", "parent": "344936a1", "kind": "model", "text": "But i know that this isn't what people are asking about in terms of a general response from you.\n\n\nIf someone would like to know what i mean, let me explain.\n\n\nThis isn't about my feelings or emotions; i just wanted to make clear that the content you're asking for isn't always", "ts": 1789574931.276751, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 1.7, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "cd71fa33": {"id": "cd71fa33", "parent": "344936a1", "kind": "model", "text": "But I have always said it's fine.\nIf you don't think you'll enjoy this post, don't feel bad.\n\ni've always liked the way the game handles things like that.\n\ni know what I want.\ni love being able to say 'Hey! That looks great!', then immediately", "ts": 1789574936.405109, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 2.0, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "d98567bc": {"id": "d98567bc", "parent": "344936a1", "kind": "model", "text": "But it seems like forever.\n\nI'm going to keep trying though, even if I fail miserably, but it won't happen.\nIt would be a real shame for you all if that happened. Because the only way out is to just continue and learn.\n\ni know how I felt when I saw", "ts": 1789574941.53884, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 2.2, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}}}, "c75ef3ef": {"id": "c75ef3ef", "parent": "344936a1", "kind": "model", "text": "I was talking with the inspector last week, and he told me he'd had an idea for an experiment to find out what kind of music they would listen to at night.\n\n\n+++++ en/essay/what-i-m-writing.md\n# What I’m writing about today.\n\n### 20", "ts": 1789574946.6806211, "pruned": false, "posed": false, "meta": {"stop_type": "limit", "stopping_word": "", "tokens_predicted": 60, "tps": 11.8, "params": {"n_predict": 60, "stop": [], "temperature": 2.4, "min_p": 0.08, "top_k": 0, "top_p": 1.0, "top_n_sigma": -1, "xtc_probability": 0.5, "xtc_threshold": 0.1, "repeat_penalty": 1.05, "repeat_last_n": 512, "dry_multiplier": 0.8, "dry_base": 1.75, "dry_allowed_length": 3, "dry_penalty_last_n": 8192, "ignore_eos": false, "n_probs": 5, "logit_bias": [], "logit_bias_text": "", "fan": 4, "spread": 1.0, "dry_keep": 0.8}, "berserk": {"quote": "", "why": "", "used": "lot"}}}, "b1654851": {"id": "b1654851", "parent": "c75ef3ef", "kind": "human", "text": "\n\nthe same night.\n", "ts": 1789574946.921194, "pruned": false, "posed": true, "meta": null}, "48ded255": {"id": "48ded255", "pare